# ==============================================================================
# Artisan Roast Coffee Shop AI Agent — Environment Configuration
# ==============================================================================

# Rasa Pro License Key (Required for Mantle / CALM v2 engine & voice)
RASA_LICENSE=your_rasa_pro_license_key_here

# Google Gemini API Key (Default LLM Provider for reasoning & NLG rephrasing)
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API Key (Speech-to-Text & Text-to-Speech for voice interactions)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Langfuse Observability & Tracing (Optional - Free Tier OpenTelemetry)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Executive Security PIN for CEO Analytics (Defaults to 8888)
CEO_SECURITY_PIN=<PIN>
