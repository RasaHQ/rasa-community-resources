# ==============================================================================
# Copy this file to `.env` and fill in the required values below:
#
#     make env      creates .env from this file
#     make verify   checks that everything is set correctly
#
# NEVER commit `.env` — it is gitignored on purpose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required — Rasa Pro
# ------------------------------------------------------------------------------
# Free Developer Edition license (a long JWT, all on one line, no quotes).
# Request one: https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# ------------------------------------------------------------------------------
# Required — LLM (routing + conversation)
# ------------------------------------------------------------------------------
# OpenAI (get a key: https://platform.openai.com/api-keys) is primary; Groq
# (get a key: https://console.groq.com/keys) is the fallback only — see
# integrations.yml for the router config. Both are required.
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Required — reference-doc embeddings (condition dietary-guideline retrieval)
# ------------------------------------------------------------------------------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Required — Voice (Deepgram handles BOTH directions)
# ------------------------------------------------------------------------------
# One key covers speech-to-text (Flux) and text-to-speech (Aura).
# Get a key: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# Optional — USDA FoodData Central (real nutrient lookups)
# ------------------------------------------------------------------------------
# Falls back to the public rate-limited DEMO_KEY if unset. Get your own free
# key (no cost, higher rate limit): https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=DEMO_KEY

# ------------------------------------------------------------------------------
# Optional — development
# ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false

# Only needed if you hit SSL_CERTIFICATE_VERIFY_FAILED against Groq/Deepgram
# with a uv-managed Python. Point at certifi inside this project's .venv:
#   macOS/Linux: .venv/lib/python3.13/site-packages/certifi/cacert.pem
#   Windows:     .venv/Lib/site-packages/certifi/cacert.pem  (Lib is capital L)
# SSL_CERT_FILE=
