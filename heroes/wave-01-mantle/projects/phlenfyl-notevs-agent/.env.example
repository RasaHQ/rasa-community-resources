# Copy this to .env and fill in your real values. .env is gitignored.

# Which LLM this agent uses — groq (default), openai, or anthropic. Same
# three providers/models as the NoteVs VS Code extension's Settings → Agent
# picker. start.sh reads this and requires the matching key below.
LLM_PROVIDER=groq

# Only the key matching LLM_PROVIDER above needs a real value.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rasa's docs reference both RASA_LICENSE and RASA_PRO_LICENSE for the same
# thing depending on the page — start.sh exports your key under both names
# so whichever the installed rasa-pro version actually reads, it's set.
RASA_LICENSE=

# Notes remain on the desktop running the NoteVs extension.
# Its unauthenticated endpoint must stay local; never expose or tunnel it.
# Optional override; the default is already local. Uncomment to change it.
# NOTEVS_CALL_URL=http://localhost:37492/call
# Required for every note read/write. Absolute EXISTING directory on that desktop,
# not the Codespace's /workspaces path. Blank or invalid scope refuses note I/O.
# Uncomment and fill this for standalone use. Leaving it commented preserves
# the per-window value injected by the NoteVs extension.
# NOTEVS_FOLDER_PATH=/absolute/existing/workspace
