# Rasa Developer Edition. Required for uv run agent-eval (rasa train).
RASA_LICENSE=

# NVIDIA Build. SkillEvaluator rubric / Tier 2 / Tier 3, and llm.provider: nvidia
# Used by llm.improver, llm.judge, llm.embeddings (actors are local GGUF).
# https://build.nvidia.com/
NVIDIA_API_KEY=

# OpenAI. Used when llm.judge.backup_provider (or llm.*.provider) is openai.
# DeepEval switches here after NVIDIA 429/503/410 or a GEval schema mismatch.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local llama.cpp OpenAI-compatible servers (llm.*.provider: local).
# Per-agent base_url in config.yaml overrides LLAMA_BASE_URL:
#   LFM2-2.6B     http://127.0.0.1:8081/v1
#   LFM2-1.2B     http://127.0.0.1:8082/v1
#   llama-8b      http://127.0.0.1:8083/v1
#   nemotron-8b   http://127.0.0.1:8084/v1
#   muse-30b      http://127.0.0.1:8085/v1
#   gemma4-31b    http://127.0.0.1:8086/v1
# One CUDA llama-server at a time. eval.llama_n_gpu_layers=99 offloads all layers.
# 0 = CPU-only. Optional override: LLAMA_N_GPU_LAYERS=99
LOCAL_LLM_API_KEY=not-needed
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
# Linux CUDA build (this cluster): llama.cpp/build/bin/llama-server
# Windows fallback is only used on win32 if this is unset and llama-server is not on PATH.
LLAMA_SERVER_EXE=

# Hosted W&B progress (optional). Sign in at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=rasa-skill-eval
# WANDB_ENTITY=your_username

# Hugging Face token for GGUF download if a repo is gated
HF_TOKEN=

# SkillEvaluator optional overrides (unused by this package; documented for the CLI)
SKILL_EVAL_LLM_PROVIDER=nv_build
SKILL_EVAL_LLM_MODEL=
SKILL_EVAL_EMBEDDING_MODEL=
