# TerraEnergy — shared environment variables.
# Copy to `.env` at the project root and fill in every key before starting
# any service.  The backend reads this file via backend/config.py.

# Rasa Pro licence (mandatory) + Mistral API key (LLM + embeddings)
RASA_LICENSE=
MISTRAL_API_KEY=

# NASA POWER endpoint (has a sensible default)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Rasa server REST webhook
RASA_REST_URL=http://localhost:5005

# Optional weather provider keys (ERA5 / NSRDB)
CDS_API_KEY=
NSRDB_API_KEY=

# Optional Neuphonic key (voice TTS in Rasa)
NEUPHONIC_API_KEY=
