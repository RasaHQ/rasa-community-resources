# ==============================================================================
# TerraEnergy — shared environment variables.
# Copy this file to `.env` at the project root and fill in every key before
# starting any service:
#
#     make env       creates .env from this file (never overwrites)
#     make verify    checks that everything is set correctly
#
# NEVER commit `.env` — it is gitignored on purpose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required — Rasa Pro + orchestrator LLM
# ------------------------------------------------------------------------------
# Free Developer Edition license (a long JWT, all on one line, no quotes).
# Request one: https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Mistral API key — used for the orchestrator LLM (ministral-14b-latest) and
# the reference embeddings model (mistral/mistral-embed).
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# Optional — weather provider keys (ERA5 / NSRDB)
# ------------------------------------------------------------------------------
# CDS_API_KEY / NSRDB_API_KEY unlock the CDS (Copernicus Climate Data Store)
# and NSRDB providers in the FastAPI backend. Leave empty to fall back to the
# free NASA POWER / PVGIS / Open-Meteo providers.
CDS_API_KEY=
NSRDB_API_KEY=

# ------------------------------------------------------------------------------
# Optional — voice (local Whisper bridge + Neuphonic TTS)
# ------------------------------------------------------------------------------
# Neuphonic API key for the optional Neuphonic TTS engine.
NEUPHONIC_API_KEY=

# Local Whisper model size used by the voice bridge (tiny/base/small/medium/large-v3).
WHISPER_MODEL=medium

# ------------------------------------------------------------------------------
# Optional — endpoints with sensible defaults
# ------------------------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
RASA_REST_URL=http://localhost:5005