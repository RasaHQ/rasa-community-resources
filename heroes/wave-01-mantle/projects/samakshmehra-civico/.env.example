# Copy to `.env` and fill in the three required values.
#   make env      creates .env from this file
#   make verify   checks that everything is set correctly
# NEVER commit `.env`.

# Rasa Pro Developer Edition licence (a long JWT, one line, no quotes).
RASA_LICENSE=

# LLM for routing + conversation.
OPENAI_API_KEY=

# Speech-to-text (Flux) and text-to-speech (Aura) — one key covers both.
DEEPGRAM_API_KEY=

# Set to 1 to make file_complaint fail — demonstrates the on_failure lever.
# CIVICO_FORCE_FILE_FAILURE=1

# How close a locality name has to sound before the directory accepts it.
# Lower catches more mangled speech; too low starts matching the wrong ward.
# CIVICO_MATCH_THRESHOLD=0.72

# The model archive does not contain data/, so tools resolve it from the
# working directory. Set this when the agent is started from somewhere else.
# CIVICO_PROJECT_ROOT=/absolute/path/to/civico

# Optional separate database for a rehearsal or evaluation. Parent must exist.
# CIVICO_DB_PATH=/absolute/path/to/demo-directory/civico.db
