# ==============================================================================
# Copy this file to .env and fill in the values.
#
#     make env        does the copy for you
#
# .env is gitignored. Never commit it. Never paste these values anywhere public.
# Full walkthrough, including where each value comes from: SETUP.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Required — you cannot start the agent without these two
# ------------------------------------------------------------------------------

# Free Developer Edition key, emailed to you after requesting it at
# https://rasa.com/rasa-pro-developer-edition-license-key-request
# It is a long string starting with "eyJ".
RASA_LICENSE=

# https://platform.openai.com/api-keys  — starts with "sk-".
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. The CRM — leave these alone to run without a HubSpot account
# ------------------------------------------------------------------------------
# As shipped, these point at the mock CRM bundled with the tutorial. Start it
# with `make mock` in a second terminal and everything works offline.

HUBSPOT_BASE_URL=http://127.0.0.1:8787
HUBSPOT_ACCESS_TOKEN=mock-token

# ------------------------------------------------------------------------------
# 3. Switching to real HubSpot  (SETUP.md steps 2–4)
# ------------------------------------------------------------------------------
# a. Create a private app:
#      HubSpot → Development → Legacy apps → Create legacy app → Private
#      (you must be a super admin to see this menu)
#
# b. On the Scopes tab, tick:
#      crm.objects.contacts.read     look the caller up by email
#      tickets                       read the tickets on their account
#      crm.objects.notes.write       write the call summary to their timeline
#
#    Cannot find crm.objects.notes.write? It is not offered on every plan.
#    Tick crm.objects.contacts.write instead — on those accounts the engagement
#    APIs fall back to it. `make crm-check` tells you which one you have.
#
# c. Copy the token from the app's Auth tab (Show token → Copy), then:
#      - paste it as HUBSPOT_ACCESS_TOKEN above
#      - COMMENT OUT the HUBSPOT_BASE_URL line above
#        so it falls back to https://api.hubapi.com
#
# d. Check it before running the agent:
#      make crm-check EMAIL=you@yourcompany.com
#
#    That writes one test note to that contact's timeline. Delete it after.

# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RASA_TELEMETRY_ENABLED=false
