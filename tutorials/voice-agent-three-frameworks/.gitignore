# The root .gitignore drops every results/ folder; the recorded runs here are
# evidence and are committed. Server logs and raw usage stay local.
!results/
results/**/raw/
.venv/
__pycache__/
*.pyc
# Temporary copies: guard-off baselines and the Rasa speech variants (make rasa-variant)
*-guard-off/
rasa-deepgram*/
