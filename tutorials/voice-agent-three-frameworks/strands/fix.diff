+    def test_an_answer_before_the_question_has_played_is_asked_again(self):
+        # The fix: a pending Confirm is not answered with a turn that began before the question
+        # finished playing; the question is spoken again and the interrupt stays pending.
+        import time
+        from types import SimpleNamespace
+
+        from starlette.testclient import TestClient
+
+        import server
+
+        refills.reset_services()
+        cid = "proto-early-yes"
+        conv = cedar.Conversation(cid, model=ScriptedModel([]))
+        conv.pending = [SimpleNamespace(id="i-1", reason="Would you like me to do that?")]
+        cedar.CONVERSATIONS[cid] = conv
+
+        async def no_asr(self):
+            raise RuntimeError("offline")
+
+        with mock.patch.object(server, "TTS", FakeTTS()), mock.patch.object(server.SpeechmaticsASR, "open", no_asr):
+            client = TestClient(server.app)
+            with client.websocket_connect(server.WS_PATH, headers={"X-Rasa-Sender-Id": cid}) as ws:
+                ws.receive_json()
+                self.until_turn_end(client, ws, cid, 1)          # greeting, not yet played
+                ws.send_text(json.dumps({"text": "Yes, please."}))
+                frames = self.until_turn_end(client, ws, cid, 2)
+                for f in frames:
+                    if "marker" in f:
+                        ws.send_text(json.dumps({"marker": f["marker"]}))
+                time.sleep(0.2)
+                ws.send_text(json.dumps({"text": "Yes.", "speech_started_at": time.time() - 30}))
+                self.until_turn_end(client, ws, cid, 3)
+            events = client.get(f"/conversations/{cid}/events").json()["events"]
+        bots = [e["text"] for e in events if e["event"] == "bot"]
+        self.assertEqual(bots[1:], ["Would you like me to do that?", "Would you like me to do that?"])
+        self.assertEqual(len(conv.pending), 1)
+        self.assertEqual(conv.agent.model.calls, 0)
+
     @staticmethod
     def until_turn_end(client, ws, cid: str, ends: int) -> list[dict]:
         import time
