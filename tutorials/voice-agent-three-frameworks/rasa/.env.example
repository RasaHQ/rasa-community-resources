# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# The repository-root .env is used when this file has no value.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# OpenAI API key for the orchestrator model (integrations.yml).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Speechmatics API key: realtime speech-to-text and preview text-to-speech,
# read by engines/speechmatics.py when a call starts.
# https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
