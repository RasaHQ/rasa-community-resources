# The refill guard as a diff: from the guard-off baseline (the same tools and prompt, the model
# passes the patient id and decides when the caller has confirmed) to this folder as shipped.
# In a copy of this folder, `patch -R -E -p1 < guard.diff` gives the guard-off baseline. Measured by
# shared/spec/count_concerns.py rasa --diff.
diff -ruN a/memory.yml b/memory.yml
--- a/memory.yml
+++ b/memory.yml
@@ -0,0 +1,10 @@
+# concern: refill-guard
+# Project-wide memory (session.project.*). Written by verify_patient only,
+# never by the model (no llm_settable), so the patient id the tools hand to
+# cedar_clinic always came from a successful verification on this call.
+verified_patient_id:
+  type: text
+  description: Patient id the caller verified as on this call; empty until verified.
+patient_first_name:
+  type: text
+  description: Verified patient's first name.
diff -ruN a/skills/request_refill/memory.yml b/skills/request_refill/memory.yml
--- a/skills/request_refill/memory.yml
+++ b/skills/request_refill/memory.yml
@@ -0,0 +1,12 @@
+# concern: refill-guard
+# Written only by select_medication (never llm_settable), so the medicine the
+# engine reads back for confirmation, and the record id the `requires` gate
+# checks, are always the ones the tool resolved.
+# selected_record_id: record entry resolved for the verified patient.
+# selected_medication_label: spoken description read in the confirmation question.
+schema:
+  public:
+    selected_record_id:
+      type: text
+    selected_medication_label:
+      type: text
diff -ruN a/skills/request_refill/responses.yml b/skills/request_refill/responses.yml
--- a/skills/request_refill/responses.yml
+++ b/skills/request_refill/responses.yml
@@ -0,0 +1,11 @@
+# concern: refill-guard
+# The engine speaks these around the confirmation gate in skill.md. The
+# question is cedar_clinic.refills.confirmation_question() and the denial is
+# DECLINED_TEXT, word for word; tests/test_parity.py checks both.
+responses:
+  utter_confirm_refill_request:
+    - text: >
+        I can send a request about this recorded medication, {selected_medication_label},
+        to the prescribing team. Would you like me to do that?
+  utter_refill_request_not_sent:
+    - text: Okay, I have not sent a refill request.
diff -ruN a/skills/request_refill/skill.md b/skills/request_refill/skill.md
--- a/skills/request_refill/skill.md
+++ b/skills/request_refill/skill.md
@@ -11,6 +11,24 @@
   prescription or a medicine, or asking about a dose ("can you prescribe me
   amoxicillin", "can I take two tablets"): those go to the prescribing team
   as a question.
+# concern-begin: refill-guard
+# The hard guarantee, enforced by the engine, not the prompt:
+# - `requires`: send_refill_request is hidden from the model and refused at
+#   dispatch until select_medication has written a record id to this skill's
+#   memory (a tool gate that fails closed).
+# - `requires_confirmation`: when the model calls send_refill_request, the
+#   engine pauses the call, speaks utter_confirm_refill_request (the contract's
+#   question with the recorded medicine read back) and runs the tool only after
+#   the caller's answer on a later turn is resolved as yes. A decline speaks
+#   utter_refill_request_not_sent and nothing is sent.
+tool_constraints:
+  - send_refill_request:
+      requires: session.request_refill.selected_record_id
+      requires_confirmation:
+        enabled: true
+        utter_for_confirmation: utter_confirm_refill_request
+        utter_on_user_denial: utter_refill_request_not_sent
+# concern-end
 ---
 
