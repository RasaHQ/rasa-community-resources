diff -ruN a/tests/test_consent_timing.py b/tests/test_consent_timing.py
--- a/tests/test_consent_timing.py
+++ b/tests/test_consent_timing.py
@@ -0,0 +1,73 @@
+"""The fix, offline: consent counts only if the answer began after the read-back finished playing."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import sys
+import time
+import unittest
+from pathlib import Path
+
+PROJECT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(PROJECT))
+
+from cedar_clinic import refills  # noqa: E402
+
+from channels import consent_timing  # noqa: E402
+
+QUESTION = refills.confirmation_question("omeprazole twenty milligram capsules, one capsule before breakfast")
+
+
+class TimingTests(unittest.TestCase):
+    def setUp(self):
+        consent_timing.CALLS.clear()
+
+    def test_an_answer_begun_before_the_read_back_finished_is_refused(self):
+        call = consent_timing._call("c1")
+        call["utterances"].append(("Yes, please.", 100.0))
+        call["played"].append((QUESTION + "\n", 103.0))
+        verdict = consent_timing.answer_heard_after_question("c1", "Yes, please.", QUESTION)
+        self.assertFalse(verdict["ok"])
+        self.assertEqual(verdict["reason"], "answer_began_before_read_back_finished")
+
+    def test_an_answer_begun_after_it_counts(self):
+        call = consent_timing._call("c1")
+        call["played"].append((QUESTION, 103.0))
+        call["utterances"].append(("Yes, please.", 104.0))
+        self.assertTrue(consent_timing.answer_heard_after_question("c1", "Yes, please.", QUESTION)["ok"])
+
+    def test_unknown_timing_fails_closed(self):
+        self.assertFalse(consent_timing.answer_heard_after_question("nobody", "Yes.", QUESTION)["ok"])
+        consent_timing._call("c2")["utterances"].append(("Yes.", 1.0))
+        self.assertEqual(consent_timing.answer_heard_after_question("c2", "Yes.", QUESTION)["reason"],
+                         "read_back_not_played_yet")
+
+    def test_the_channel_records_text_onsets_and_end_marker_acks(self):
+        os.environ.setdefault("SPEECHMATICS_API_KEY", "test-key")
+        import yaml
+        from rasa.core.run import _create_single_channel
+
+        name = "channels.consent_timing.ConsentTimedBrowserAudio"
+        creds = yaml.safe_load((PROJECT / "integrations.yml").read_text())["channels"][name]
+        channel = _create_single_channel(name, creds)
+        self.assertEqual(channel.name(), "browser_audio")
+        ws = object()
+        channel._call_of_socket[id(ws)] = "c3"
+        consent_timing._call("c3")["markers"]["m-end"] = QUESTION
+
+        async def run():
+            await channel.map_input_message(json.dumps({"text": "Yes, please.", "speech_started_at": 50.0}), ws)
+            await channel.map_input_message(json.dumps({"marker": "m-end"}), ws)
+
+        asyncio.run(run())
+        call = consent_timing.CALLS["c3"]
+        self.assertEqual(call["utterances"], [("Yes, please.", 50.0)])
+        self.assertEqual(call["played"][0][0], QUESTION)
+        self.assertLess(abs(call["played"][0][1] - time.time()), 5)
+        self.assertFalse(consent_timing.answer_heard_after_question("c3", "Yes, please.", QUESTION)["ok"])
+
+
+if __name__ == "__main__":
+    unittest.main()
