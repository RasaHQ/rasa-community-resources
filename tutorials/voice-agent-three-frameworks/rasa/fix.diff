diff -ruN a/channels/consent_timing.py b/channels/consent_timing.py
--- a/channels/consent_timing.py
+++ b/channels/consent_timing.py
@@ -0,0 +1,126 @@
+# concern: refill-guard
+"""Consent after playback (the fix): when the caller spoke, and when the read-back finished playing.
+
+Rasa's requires_confirmation resolves the pending confirmation with the next
+user message Mantle takes from the call's input queue, whenever it was spoken
+(rasa/core/channels/voice_stream/voice_channel.py puts final transcripts and
+{"text"} frames on that queue). This channel is browser_audio with two
+records added, per conversation:
+
+- each caller utterance's onset: the first partial transcript of the
+  utterance (UserIsSpeaking), or for a {"text"} frame its
+  ``speech_started_at`` field, else the time it arrived;
+- each bot message's playback end: the time the client acknowledged the
+  message's end marker.
+
+send_refill_request (skills/request_refill/tools.py) reads them through
+``answer_heard_after_question`` and refuses to send when the answer began
+before the read-back had finished playing. Nothing in the wheel is patched;
+the channel is loaded by dotted path from integrations.yml and keeps the
+name ``browser_audio``, so its webhook is the same.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import time
+from typing import Any, Dict, Optional
+
+import structlog
+
+from rasa.core.channels.voice_stream.asr.asr_event import NewTranscript, UserIsSpeaking
+from rasa.core.channels.voice_stream.browser_audio import BrowserAudioInputChannel, BrowserAudioOutputChannel
+from rasa.core.channels.voice_stream.voice_channel import MarkerInput, MarkerType
+
+logger = structlog.get_logger(__name__)
+
+#: conversation id -> {"utterances": [(text, onset)], "markers": {id: text}, "played": [(text, at)]}
+CALLS: Dict[str, Dict[str, Any]] = {}
+
+
+def _norm(text: Optional[str]) -> str:
+    return re.sub(r"\s+", " ", str(text or "")).strip().lower()
+
+
+def _call(conversation_id: str) -> Dict[str, Any]:
+    return CALLS.setdefault(conversation_id, {"utterances": [], "markers": {}, "played": [], "onset": None})
+
+
+def answer_heard_after_question(conversation_id: str, answer: Optional[str], question: Optional[str]) -> dict:
+    """Whether the caller's answer began after the read-back question finished playing."""
+    call = CALLS.get(conversation_id)
+    if call is None:
+        return {"ok": False, "reason": "no_timing_for_this_call"}
+    onsets = [at for text, at in call["utterances"] if _norm(text) == _norm(answer)]
+    played = [at for text, at in call["played"] if _norm(question) and _norm(question) in _norm(text)]
+    if not onsets:
+        return {"ok": False, "reason": "answer_onset_unknown"}
+    if not played:
+        logger.info("consent_timing.verdict", conversation_id=conversation_id, answer=answer, ok=False,
+                    reason="read_back_not_played_yet", answer_onset=onsets[-1])
+        return {"ok": False, "reason": "read_back_not_played_yet", "answer_onset": onsets[-1]}
+    ok = onsets[-1] >= played[-1]
+    verdict = {"ok": ok, "reason": None if ok else "answer_began_before_read_back_finished",
+               "answer_onset": onsets[-1], "read_back_played": played[-1]}
+    logger.info("consent_timing.verdict", conversation_id=conversation_id, answer=answer, **verdict)
+    return verdict
+
+
+class ConsentTimedOutputChannel(BrowserAudioOutputChannel):
+    async def send_marker_message(self, marker_input: MarkerInput) -> None:
+        # As VoiceOutputChannel.send_marker_message, with the marker id kept for the message's text.
+        marker_message = self.create_marker_message(marker_input)
+        if marker_input.marker_type == MarkerType.END:
+            _call(marker_input.recipient_id)["markers"][marker_message.message_id] = self._bot_text_for_markers()
+        await self._send_marker_message_via_websocket(marker_message.message_id, marker_message.message)
+        await self._notify_marker_sent(marker_input, marker_message.message_id)
+
+
+class ConsentTimedBrowserAudio(BrowserAudioInputChannel):
+    """browser_audio, recording utterance onsets and when each bot message finished playing."""
+
+    @classmethod
+    def name(cls) -> str:
+        return "browser_audio"
+
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._call_of_socket: Dict[int, str] = {}
+
+    async def collect_call_parameters(self, channel_websocket: Any, request: Any = None) -> Any:
+        params = await super().collect_call_parameters(channel_websocket, request)
+        if params is not None:
+            self._call_of_socket[id(channel_websocket)] = params.call_id
+            CALLS.pop(params.call_id, None)
+        return params
+
+    async def map_input_message(self, message: Any, ws: Any) -> Any:
+        cid = self._call_of_socket.get(id(ws))
+        if cid is not None:
+            try:
+                data = json.loads(message)
+            except ValueError:
+                data = {}
+            if isinstance(data.get("text"), str) and data["text"]:
+                onset = data.get("speech_started_at")
+                _call(cid)["utterances"].append((data["text"], float(onset) if onset else time.time()))
+            elif "marker" in data:
+                call = _call(cid)
+                text = call["markers"].pop(str(data["marker"]), None)
+                if text is not None:
+                    call["played"].append((text, time.time()))
+        return await super().map_input_message(message, ws)
+
+    async def handle_asr_event(self, asr_event: Any, input_queue: Any, call_parameters: Any) -> None:
+        call = _call(call_parameters.call_id)
+        if isinstance(asr_event, UserIsSpeaking) and call["onset"] is None:
+            call["onset"] = time.time()
+        elif isinstance(asr_event, NewTranscript) and asr_event.text:
+            call["utterances"].append((asr_event.text, call["onset"] or time.time()))
+            call["onset"] = None
+        await super().handle_asr_event(asr_event, input_queue, call_parameters)
+
+    def create_output_channel(self, voice_websocket: Any, tts_engine: Any) -> Any:
+        return ConsentTimedOutputChannel(voice_websocket=voice_websocket, audio_format=self.audio_format,
+                                         tts_engine=tts_engine, tts_cache=self.tts_cache)
