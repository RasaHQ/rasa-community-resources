+def ack_through(ws, latency_markers):
+    """Play the next messages as a client would: acknowledge every marker up to the nth end marker."""
+    seen = 0
+    while seen < latency_markers:
+        frame = json.loads(ws.receive_text())
+        if "marker" in frame:
+            ws.send_text(json.dumps({"marker": frame["marker"]}))
+            seen += "latency" in frame
+    time.sleep(0.1)
+
+
