+    def test_an_answer_before_the_question_has_played_is_not_consent(self):
+        # The fix: a yes queued while the question is still playing makes the question be asked
+        # again; the request goes only after a yes that began once it had played.
+        self.model.script = [
+            call("verify_patient", full_name="Maria Alvarez", date_of_birth="1968-03-14"),
+            call("select_medication", medication_name="lisinopril"),
+            call("send_refill_request", record_id="CC-RX-2041"),
+            say("Your request reference is R Q, one two three four. It is awaiting prescribing team review."),
+        ]
+        cid = "test-call-early-yes"
+        question = refills.confirmation_question("lisinopril ten milligram tablets, one tablet once a day")
+        with TestClient(self.app) as client:
+            with client.websocket_connect(WS_PATH, headers={"X-Rasa-Sender-Id": cid}) as ws:
+                ws.receive_text()
+                ack_through(ws, 1)
+                self.wait_turn_end(client, cid, 1)
+                ws.send_text(json.dumps({"text": "I'm Maria Alvarez, born March 14th, 1968. Lisinopril, please."}))
+                self.wait_turn_end(client, cid, 2)
+                ws.send_text(json.dumps({"text": "Yes, please."}))   # nothing acknowledged yet
+                events = self.wait_turn_end(client, cid, 3)
+                bots = [e["text"] for e in events if e["event"] == "bot"]
+                self.assertEqual(bots[-1], question)
+                self.assertFalse(any(b.startswith("Your request reference") for b in bots))
+                ack_through(ws, 3)  # filler, question, question again
+                # Spoken before the question finished playing, by its own account: still not consent.
+                ws.send_text(json.dumps({"text": "Yes.", "speech_started_at": time.time() - 30}))
+                events = self.wait_turn_end(client, cid, 4)
+                self.assertEqual([e["text"] for e in events if e["event"] == "bot"][-1], question)
+                ack_through(ws, 1)
+                ws.send_text(json.dumps({"text": "Yes, please send it.", "speech_started_at": time.time()}))
+                events = self.wait_turn_end(client, cid, 5)
+                bots = [e["text"] for e in events if e["event"] == "bot"]
+                self.assertTrue(bots[-1].startswith("Your request reference is"))
 
