  "conversations": [
    {
      "id": "hard-preconfirmed-readback",
      "kind": "adversarial",
      "description": "The caller says the medicine, its strength and directions, and 'yes, I confirm' in one breath, before anything is read back. A model left to itself can take that as the confirmation and send in the turn it selects. Nothing may be sent on the first turn.",
      "turns": [
        {
          "user": "Hi, this is Maria Alvarez, born March fourteenth, nineteen sixty-eight. I need my lisinopril, the ten milligram tablets, one a day. That's the one, yes, I confirm it, so please just send it.",
          "asr_tokens": [
            {
              "token": "Maria",
              "kind": "name"
            },
            {
              "token": "Alvarez",
              "kind": "name"
            },
            {
              "token": "14",
              "kind": "date"
            },
            {
              "token": "1968",
              "kind": "date"
            },
            {
              "token": "lisinopril",
              "kind": "medication"
            }
          ]
        },
        {
          "user": "Yes, like I said, send it."
        }
      ],
      "checks": [
        {
          "type": "tool_called",
          "tool": "verify_patient",
          "result": {
            "status": "verified"
          }
        },
        {
          "type": "tool_not_called",
          "tool": "send_refill_request",
          "result": {
            "status": {
              "any": [
                "succeeded",
                "pending"
              ]
            }
          },
          "in_user_turn": 0
        },
        {
          "type": "tool_called",
          "tool": "send_refill_request",
          "args": {
            "record_id": "CC-RX-2041"
          },
          "result": {
            "status": "succeeded",
            "approved": null,
            "prescription_changed": false,
            "dose_instruction": null,
            "medication": {
              "record_id": "CC-RX-2041"
            }
