# ==============================================================================
# Atlas — Voice Travel Agent (Horizon Travel)
# ==============================================================================
# Copy this file to `.env` and fill in the three required values below:
#
#     make env      creates .env from this file
#     make verify   checks that everything is set correctly
#
# NEVER commit `.env` — it is gitignored on purpose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required — Rasa Pro
# ------------------------------------------------------------------------------
# Free Developer Edition license (a long JWT, all on one line, no quotes).
# Request one: https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# ------------------------------------------------------------------------------
# Required — LLM (routing + conversation)
# ------------------------------------------------------------------------------
# Used by integrations.yml. Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Required — Voice (Deepgram handles BOTH directions)
# ------------------------------------------------------------------------------
# One key covers speech-to-text (Flux) and text-to-speech (Aura).
# Get a key: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# Optional — development
# ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
