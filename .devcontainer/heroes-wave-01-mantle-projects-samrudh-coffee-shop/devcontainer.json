      "description": "Required. Full Rasa Developer Edition license"
    },
    "GEMINI_API_KEY": {
      "description": "Required. Google Gemini key used for this resource's model calls"
    },
    "DEEPGRAM_API_KEY": {
      "description": "Required. Deepgram key for speech recognition and spoken replies"
    },
    "LANGFUSE_PUBLIC_KEY": {
      "description": "Optional. Langfuse public key for this resource's tracing"
    },
    "LANGFUSE_SECRET_KEY": {
      "description": "Optional. Langfuse secret key for this resource's tracing"
    }
  },
  "onCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/install.sh\" heroes/wave-01-mantle/projects/samrudh-coffee-shop",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/ready.sh\" heroes/wave-01-mantle/projects/samrudh-coffee-shop \"python3 \\\"$(git rev-parse --show-toplevel)/scripts/check_project.py\\\" heroes/wave-01-mantle/projects/samrudh-coffee-shop --skip-sync --use-project-pin\""
}
