{
  "name": "Rasa resource: tutorials/jev-with-rasa/mantle",
  "build": {
    "dockerfile": "../resource-base/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tutorials/jev-with-rasa/mantle",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    5030
  ],
  "portsAttributes": {
    "5030": {
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "RASA_LICENSE": {
      "description": "Required. Full Rasa Developer Edition license"
    },
    "OPENAI_API_KEY": {
      "description": "Required. OpenAI project key used for this resource's model calls"
    }
  },
  "onCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/install.sh\" tutorials/jev-with-rasa/mantle",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/ready.sh\" tutorials/jev-with-rasa/mantle"
}
