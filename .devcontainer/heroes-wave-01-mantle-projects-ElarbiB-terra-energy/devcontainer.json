  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/heroes/wave-01-mantle/projects/ElarbiB-terra-energy",
