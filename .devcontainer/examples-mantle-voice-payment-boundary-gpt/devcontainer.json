{
  "name": "Rasa resource: examples/mantle-voice-payment-boundary-gpt",
  "build": {
    "dockerfile": "../resource-base/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/examples/mantle-voice-payment-boundary-gpt",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    5005
  ],
  "portsAttributes": {
    "5005": {
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "RASA_LICENSE": {
      "description": "Required. Full Rasa Developer Edition license"
    },
    "OPENAI_API_KEY": {
      "description": "Required. OpenAI project key used for this resource's model calls"
    },
    "DEEPGRAM_API_KEY": {
      "description": "Required. Deepgram key for speech recognition and spoken replies"
    },
    "RIME_API_KEY": {
      "description": "Required. Rime key for spoken replies"
    }
  },
  "onCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/install.sh\" examples/mantle-voice-payment-boundary-gpt",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/ready.sh\" examples/mantle-voice-payment-boundary-gpt"
}
