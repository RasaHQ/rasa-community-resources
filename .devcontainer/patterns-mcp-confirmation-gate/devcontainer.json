{
  "name": "Rasa resource: patterns/mcp-confirmation-gate",
  "build": {
    "dockerfile": "../resource-base/Dockerfile.python312"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/patterns/mcp-confirmation-gate",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    5005
  ],
  "portsAttributes": {
    "5005": {
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "RASA_LICENSE": {
      "description": "Required. Full Rasa Developer Edition license"
    },
    "OPENAI_API_KEY": {
      "description": "Required. OpenAI project key used for this resource's model calls"
    }
  },
  "onCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/install.sh\" patterns/mcp-confirmation-gate",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/ready.sh\" patterns/mcp-confirmation-gate"
}
