{
  "name": "Rasa resource: heroes/wave-01-mantle/projects/phlenfyl-notevs-agent",
  "build": {
    "dockerfile": "../resource-base/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/heroes/wave-01-mantle/projects/phlenfyl-notevs-agent",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    5005
  ],
  "portsAttributes": {
    "5005": {
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "RASA_LICENSE": {
      "description": "Required. Full Rasa Developer Edition license"
    },
    "GROQ_API_KEY": {
      "description": "Required. Groq account key for this resource's configured model calls"
    },
    "OPENAI_API_KEY": {
      "description": "Optional. OpenAI project key used for this resource's model calls"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Anthropic key used for this resource's model calls"
    }
  },
  "onCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/install.sh\" heroes/wave-01-mantle/projects/phlenfyl-notevs-agent",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/resource-base/ready.sh\" heroes/wave-01-mantle/projects/phlenfyl-notevs-agent \"python3 \\\"$(git rev-parse --show-toplevel)/scripts/check_project.py\\\" heroes/wave-01-mantle/projects/phlenfyl-notevs-agent --skip-sync --use-project-pin\"",
  "remoteEnv": {
    "RASA_PRO_LICENSE": "${containerEnv:RASA_LICENSE}"
  }
}
