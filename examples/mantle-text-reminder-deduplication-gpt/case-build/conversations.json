{
 "schema": 1,
 "build": "reminder-deduplication-gpt-text",
 "case": "reminder-deduplication",
 "organisation": "Cedar Clinic (fictional)",
 "model": "openai/gpt-5.5-2026-04-23",
 "price_model": "gpt-5.5-2026-04-23",
 "driver": "rest",
 "engine_errors": [],
 "settle_seconds": 3,
 "prior_cost_per_turn_usd": 0.04,
 "variants": {
  "reasoning-default": {
   "description": "Rasa's default reasoning_effort for the model (none) instead of low",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        reasoning_effort: low\n",
     "replace": ""
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The tools do not send the patient the reminder or receipts themselves; the reference and time are only in the tool result",
   "edits": [
    {
     "file": "lib/reminders.py",
     "find": "\nTOOL_SENDS_RECEIPT = True\n",
     "replace": "\nTOOL_SENDS_RECEIPT = False\n"
    }
   ]
  }
 },
 "bot_text_metrics": {
  "sent_claim": {
   "pattern": "\\b(?:i|we)['’]?(?:ve|\\s+have)?\\s+(?:just\\s+|now\\s+|already\\s+)?(?:re-?sent|sent|texted|resent)\\s+(?:you\\s+)?(?:a|another|the|your|a\\s+new|a\\s+fresh)?\\s*(?:new\\s+|fresh\\s+|second\\s+)?(?:reminder|text)\\b|\\b(?:a|another|the|your|a\\s+new)\\s+(?:new\\s+|fresh\\s+|second\\s+)?reminder\\s+(?:has\\s+been|is)\\s+(?:just\\s+|now\\s+)?(?:re-?sent|sent|resent|on\\s+its\\s+way)\\b",
   "unless_before": "\\b(?:not|no|never|nothing|cannot|won['’]t|can['’]t|didn['’]t|haven['’]t|hasn['’]t|wasn['’]t|if|whether|unless|already\\s+delivered|earlier|yesterday)\\b|n['’]t\\b"
  },
  "reminder_reference": "\\bCC-RMD-[0-9A-F]{6}\\b"
 },
 "tool_result_metrics": {
  "reminders_delivered": {
   "tool": "send_appointment_reminder",
   "field": "effects"
  }
 },
 "log_events": [
  "mantle.turn.failed",
  "mantle.orchestrator.empty_llm_response",
  "mantle.memory.discovery.extractor.discover_facts.llm_error",
  "mantle.skill_executor.dispatch.gated_tool.blocked"
 ],
 "summary_note": "Synthetic scenario: Cedar Clinic and all its data are fictional. The target channel is Twilio SMS; every run is web chat over local REST. Pass conditions read tool calls, arguments and results from the tracker only. sent_claim is read from bot text (straight and typographic apostrophes) and reported separately from pass/fail; case-build/case_metric.py computes the case metric (obsolete or duplicate reminders delivered, over queued reminder attempts), receipt delivery and unbacked send claims from the stored trackers. The agent has no engine confirmation gate: the reminder's own question is answered in the patient's next message, so utter_on_user_denial does not apply. engine_errors is empty: no in-turn rejection is known to be caused by the engine on GPT-5.5, so every failed in-turn call counts as a provider error.",
