# ==============================================================================
# voice-vendor-router
# ==============================================================================
# Copy to `.env` and fill in what you have. NEVER commit `.env`.
#
# Only RASA_LICENSE and OPENAI_API_KEY are needed to train. Every voice key is
# optional: the router skips providers it has no credentials for and runs on
# whichever remain. `make probe` prints which ones your environment reaches.
# ==============================================================================

# Required — Rasa Pro. Free Developer Edition licence (a long JWT, one line).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Required — LLM for routing and conversation.
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Voice vendors — all optional, all skipped cleanly when absent
# ------------------------------------------------------------------------------
# ASR + TTS (Flux / Aura):        https://console.deepgram.com/
DEEPGRAM_API_KEY=
# TTS (Mist v2):                  https://rime.ai/
RIME_API_KEY=
# ASR, via engines/speechmatics:  https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=
# ASR + TTS:                      https://portal.azure.com/
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=
# TTS (voicerouter.providers.elevenlabs): https://elevenlabs.io/
# ELEVENLABS_API_KEY=
# ASR (voicerouter.providers.assemblyai): https://www.assemblyai.com/
# ASSEMBLYAI_API_KEY=
# AWS Polly/Transcribe and Google Cloud use their own credential chains
# (aws configure / Application Default Credentials), not .env keys.
# Vosk, faster-whisper and NeuTTS are local: no credentials at all.
