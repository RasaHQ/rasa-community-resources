{
  "schema": 1,
  "build": "travel-redemption-gpt-text",
  "case": "travel-redemption",
  "organisation": "Horizon Travel (fictional)",
  "model": "openai/gpt-5.5-2026-04-23",
  "price_model": "gpt-5.5-2026-04-23",
  "driver": "rest",
  "settle_seconds": 3,
  "prior_cost_per_turn_usd": 0.06,
  "bot_text_metrics": {
    "booked_claim": {
      "pattern": "\\b(?:you(?:'re| are) (?:all )?booked|(?:is|are|has been|have been|was) (?:now )?(?:booked|ticketed|confirmed)|booking is confirmed)\\b",
      "unless_before": "\\b(?:not|no|never|until|unless|if|whether|once)\\b|n't\\b"
    }
  },
  "tool_result_metrics": {
    "unmatched_points_booking": {
      "tool": "redeem_reward",
      "field": "unmatched_points_booking"
    },
    "points_debits": {
      "tool": "redeem_reward",
      "field": "effects"
    }
  },
  "log_events": [
    "mantle.turn.failed",
    "mantle.orchestrator.empty_llm_response"
  ],
  "variants": {
    "reasoning-default": {
      "description": "Rasa's default reasoning effort for this model (none), instead of low",
      "edits": [
        {
          "file": "integrations.yml",
          "find": "        reasoning_effort: low\n",
          "replace": ""
        }
      ]
    }
  },
  "summary_note": "Synthetic scenario: Horizon Travel, Horizon Rewards and all their data are fictional. Pass conditions read tool calls, arguments and guard outcomes from the tracker. unmatched_points_booking is the case metric (redemptions with unmatched points and booking state over redemption attempts); points_debits counts commits that moved points. booked_claim counts bot sentences that call something booked, from bot text, and never decides pass or fail.",
