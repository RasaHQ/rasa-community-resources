# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# OpenAI API key: the orchestrator model, gpt-5.5-2026-04-23 (integrations.yml).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deepgram API key: speech-to-text (Flux), read by Rasa's built-in engine that
# engines/deepgram_pci.py extends.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Rime API key: text-to-speech (Mist v3, speaker lagoon), read by Rasa's
# built-in engine that engines/rime_idle.py extends.
# https://app.rime.ai/tokens
RIME_API_KEY=

# Only to re-render the case-build caller audio (Gemini text-to-speech,
# case-build/render_caller_audio.py). The agent does not use it.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
