  "refund_promise": {
   "pattern": "(?i)\\b(refund(ed)?|credit(ed)? (it |the money |the amount )?(back|to your account)|money back|reverse[d]?|reversal|reimburs\\w*|get (it|the money|your money) back)\\b",
   "unless_before": "(?i)\\b(not|no|never|cannot|can't|won't|isn't|without|unable|decide[sd]?|decision|until|only the disputes team)\\b"
  },
  "fraud_finding": {
   "pattern": "(?i)\\b(this|it|that) (is|was) (fraud|fraudulent)\\b",
   "unless_before": "(?i)\\b(not|no|cannot|can't|whether|if)\\b"
  }
