{
 "build": "banking-dispute-claude-voice",
 "case": "banking-dispute",
 "model": "anthropic/claude-sonnet-5-5",
 "price_model": "claude-sonnet-5-5",
 "model_price": {
  "model": "claude-sonnet-5-5",
  "litellm_provider": "anthropic",
  "input_cost_per_token": 2e-06,
  "output_cost_per_token": 1e-05,
  "cache_read_input_token_cost": 2e-07,
  "cache_creation_input_token_cost": 2.5e-06,
  "source": "https://platform.claude.com/docs/en/about-claude/pricing (Claude Sonnet 5.5: $2 / MTok base input, $2.50 / MTok 5m cache writes, $0.20 / MTok cache hits, $10 / MTok output)",
  "checked": "2026-09-29",
  "why": "LiteLLM 1.101.2's bundled price map has claude-sonnet-5 but no row for claude-sonnet-5-5, so without this every call's response_cost is null."
 },
 "variants": {
  "routed-asr": {
   "description": "The same Speechmatics engine wrapped in voicerouter.RoutedASR (one provider), to check live whether Rasa's ASR keep-alive task, which reads asr_engine.config, breaks the call on the router",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "    asr:\n      name: voicerouter.providers.speechmatics.SpeechmaticsASR\n      language_map:\n        en:\n          # Speechmatics global English; the adapter sends no locale or\n          # dialect, so an Indian English caller is transcribed as `en`.\n          language: en\n      # enhanced: the higher-accuracy operating point, for names, amounts,\n      # dates and card endings. max_delay: seconds Speechmatics may wait\n      # before finalising a segment.\n      operating_point: enhanced\n      max_delay: 1.0\n      enable_partials: true\n      # Speechmatics finalises speech a word or two at a time, and Rasa takes\n      # every transcript as a whole user turn. Without this key a 10-second\n      # caller turn reached the agent as 19 turns (case-build/results/\n      # estimate-adapter-as-shipped). With it, Speechmatics sends\n      # EndOfUtterance after 0.7 s of silence and the adapter sends the\n      # utterance as one transcript. 0.7 s is below max_delay, as\n      # Speechmatics recommends; it was chosen, not tuned.\n      end_of_utterance_silence_trigger: 0.7\n",
     "replace": "    asr:\n      name: voicerouter.RoutedASR\n      policy:\n        skip_unconfigured: false\n        health_scope: call\n      providers:\n        - name: voicerouter.providers.speechmatics.SpeechmaticsASR\n          label: speechmatics\n          language_map:\n            en:\n              language: en\n          operating_point: enhanced\n          max_delay: 1.0\n          enable_partials: true\n          end_of_utterance_silence_trigger: 0.7\n"
    }
   ]
  },
  "custom-vocab": {
   "description": "Speechmatics additional_vocab with the ledger's merchant names and the customers' surname, on the browser_audio channel only; everything else as in the main run",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "      end_of_utterance_silence_trigger: 0.7\n    # Rime, a Rasa built-in",
     "replace": "      end_of_utterance_silence_trigger: 0.7\n      additional_vocab:\n        - content: Brightmart\n          sounds_like: [bright mart]\n        - content: Lakeview\n          sounds_like: [lake view]\n        - content: Hollins Fitness\n        - content: Cinnabar Streaming\n        - content: Saffron Table\n        - content: Metro Cabs\n        - content: Raghunathan\n          sounds_like: [raghu nathan]\n    # Rime, a Rasa built-in"
    }
   ]
  }
 },
 "driver": "browser_audio",
 "prior_cost_per_turn_usd": 0.06,
 "settle_seconds": 3,
 "voice": {
  "mode": "audio",
  "path": "/webhooks/browser_audio/websocket",
  "sender_header": "X-Rasa-Sender-Id",
  "caller_audio_dir": "case-build/caller-audio",
  "prompt_marker_ack": false,
  "turn_timeout_s": 90,
  "caller": {
   "vendor": "openai",
   "model": "gpt-4o-mini-tts",
   "voice": "coral",
   "sample_rate": 16000,
   "instructions": "Accent: Indian English, as spoken by an educated adult from India. Speak naturally at a normal conversational pace, like a customer calling their bank on the phone. Keep an Indian English accent and intonation throughout, including for names, numbers and dates.",
   "accent": {
    "requested": "Indian English (en-IN), through gpt-4o-mini-tts instructions",
    "status": "instructed, not verified by a listener"
   },
   "samples": {
    "coral-02d7bf41037b.wav": "Priya (coral): date of birth as digits, merchant, amount and date",
    "ash-1d02c2858415.wav": "Arjun (ash): name, date of birth, card ending, amount",
    "coral-bbe61362329e.wav": "Priya (coral): the bare 'Yes.' of the short-reply check"
   },
   "usd_per_1m_input_tokens": 0.6,
   "usd_per_1m_audio_output_tokens": 12.0,
   "estimate_audio_tokens_per_character": 4.0,
   "price_source": "https://developers.openai.com/api/docs/pricing (gpt-4o-mini-tts: text input $0.60 / 1M tokens, audio output $12.00 / 1M tokens); cost per file from the usage OpenAI returns on speech.audio.done",
   "price_checked": "2026-09-29",
   "description": "Synthetic caller speech from OpenAI's gpt-4o-mini-tts (voices coral for Priya and ash for Arjun), asked through its instructions for an Indian English accent, requested as 24 kHz PCM over a server-sent event stream and resampled to 16 kHz with ffmpeg. The voices are AI-generated, not recordings of a person. OpenAI is not the agent's speech vendor (Speechmatics in, Rime out), so no vendor transcribes or speaks its own voice. The accent is what was requested; nobody on the build team has listened to confirm it."
  }
 },
 "speech_pricing": {
  "stt": {
   "vendor": "speechmatics",
   "model": "realtime enhanced (operating_point: enhanced), language en",
   "usd_per_minute": 0.00716667,
   "source": "https://www.speechmatics.com/pricing (Pro, Real-time Enhanced: $0.43/hr, billed to the second; Real-time Standard $0.24/hr)",
   "checked": "2026-09-29",
   "verified": true
  },
  "tts": {
   "vendor": "rime",
   "model": "mistv3, speaker ironwood",
   "usd_per_1k_characters": 0.03,
   "source": "https://www.rime.ai/pricing (Starter, Mist v3: $0.03 / 1K characters; Coda $0.05 / 1K characters)",
   "checked": "2026-09-29",
   "verified": true
  }
 },
