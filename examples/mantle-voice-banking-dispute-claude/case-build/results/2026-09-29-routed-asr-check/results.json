 "variant": {
  "name": "routed-asr",
  "description": "The same Speechmatics engine wrapped in voicerouter.RoutedASR (one provider), to check live whether Rasa's ASR keep-alive task, which reads asr_engine.config, breaks the call on the router",
  "edits": [
   {
    "file": "integrations.yml",
    "find": "    asr:\n      name: voicerouter.providers.speechmatics.SpeechmaticsASR\n      language_map:\n        en:\n          # Speechmatics global English; the adapter sends no locale or\n          # dialect, so an Indian English caller is transcribed as `en`.\n          language: en\n      # enhanced: the higher-accuracy operating point, for names, amounts,\n      # dates and card endings. max_delay: seconds Speechmatics may wait\n      # before finalising a segment.\n      operating_point: enhanced\n      max_delay: 1.0\n      enable_partials: true\n      # Speechmatics finalises speech a word or two at a time, and Rasa takes\n      # every transcript as a whole user turn. Without this key a 10-second\n      # caller turn reached the agent as 19 turns (case-build/results/\n      # estimate-adapter-as-shipped). With it, Speechmatics sends\n      # EndOfUtterance after 0.7 s of silence and the adapter sends the\n      # utterance as one transcript. 0.7 s is below max_delay, as\n      # Speechmatics recommends; it was chosen, not tuned.\n      end_of_utterance_silence_trigger: 0.7\n",
    "replace": "    asr:\n      name: voicerouter.RoutedASR\n      policy:\n        skip_unconfigured: false\n        health_scope: call\n      providers:\n        - name: voicerouter.providers.speechmatics.SpeechmaticsASR\n          label: speechmatics\n          language_map:\n            en:\n              language: en\n          operating_point: enhanced\n          max_delay: 1.0\n          enable_partials: true\n          end_of_utterance_silence_trigger: 0.7\n"
   }
  ]
 },
