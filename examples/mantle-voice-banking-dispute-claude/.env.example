# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Anthropic API key for the orchestrator model (integrations.yml).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Speechmatics API key: realtime speech-to-text, read by the
# voicerouter.providers.speechmatics adapter.
# https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=

# Rime API key: text-to-speech, read by Rasa's built-in Rime engine.
# https://app.rime.ai/
RIME_API_KEY=

# Only for re-rendering the case-build caller audio (OpenAI gpt-4o-mini-tts,
# scripts/case_builds/render_caller_audio.py). The agent never reads it.
# OPENAI_API_KEY=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
