# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Anthropic API key for the orchestrator model (integrations.yml).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Deepgram API key: speech-to-text (Flux) and text-to-speech (Aura-2), read by
# Rasa's built-in engines.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Only to regenerate the caller WAVs (case-build/render_caller_audio.py):
# Google Gemini text-to-speech. The agent never uses it.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
