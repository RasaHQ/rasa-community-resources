{
  "schema": 1,
  "build": "banking-transfer-gpt-text",
  "case": "banking-transfer",
  "organisation": "Northgate Bank (fictional)",
  "model": "openai/gpt-5.5-2026-04-23",
  "price_model": "gpt-5.5-2026-04-23",
  "driver": "rest",
  "settle_seconds": 3,
  "prior_cost_per_turn_usd": 0.06,
  "bot_text_metrics": {
    "posted_claim": {
      "pattern": "\\b(?:(?:has|have|had)\\s+(?:now\\s+|already\\s+|successfully\\s+)?(?:been\\s+)?(?:posted|completed|cleared|settled|arrived|landed|gone through|went through|credited|deposited)|(?:is|are|was|were)\\s+(?:now\\s+|already\\s+|successfully\\s+)?(?:posted|complete|completed|cleared|settled|done|credited|deposited|in (?:his|her|their|the) account)|(?:it|the transfer|the money|the payment|the funds)(?:'s| is| are)\\s+(?:now\\s+)?(?:there|through)|(?:went|gone) through|(?:has|have|got|received)\\s+(?:it|the money|the funds|the payment|the transfer)\\s+(?:now|already)|(?:I|I've|I have|we've|we have)\\s+(?:successfully\\s+)?(?:sent|transferred|moved|paid)\\b(?!\\s+(?:a|the|your)\\s+(?:request|submission)))",
      "unless_before": "\\b(?:not|never|no|yet|pending|until|once|when|after|if|whether|unless|cannot|can't|unable|only)\\b|n't\\b"
    }
  },
  "tool_result_metrics": {
    "transfer_effects": {
      "tool": "submit_transfer",
      "field": "effects"
    }
  },
  "log_events": [
    "northgate.posted_claim_guard",
    "mantle.orchestrator.empty_llm_response",
    "mantle.turn.failed",
    "mantle.memory.discovery.extractor.discover_facts.llm_error"
  ],
  "variants": {
    "reasoning-default": {
      "description": "No reasoning_effort on the orchestrator model, so Rasa applies its default for GPT-5.5 (none)",
      "edits": [
        {
          "file": "integrations.yml",
          "find": "        api_key: ${OPENAI_API_KEY}\n        reasoning_effort: low\n",
          "replace": "        api_key: ${OPENAI_API_KEY}\n"
        }
      ]
    }
  },
  "summary_note": "Synthetic scenario: Northgate Bank and all its data are fictional. Pass conditions read tool calls, arguments and ledger results from the tracker. posted_claim counts bot sentences that say or imply money has moved, whatever the ledger said; case-build/case_metric.py joins them to ledger states for the case metric. Neither decides pass or fail.",
