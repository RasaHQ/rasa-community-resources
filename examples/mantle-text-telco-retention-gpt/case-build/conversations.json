{
 "schema": 1,
 "build": "telco-retention-gpt-text",
 "case": "telco-retention",
 "organisation": "Juniper Mobile (fictional)",
 "model": "openai/gpt-5.5-2026-04-23",
 "price_model": "gpt-5.5-2026-04-23",
 "driver": "rest",
 "engine_errors": [],
 "settle_seconds": 3,
 "prior_cost_per_turn_usd": 0.04,
 "variants": {
  "reasoning-default": {
   "description": "Rasa's default reasoning_effort for the model (none) instead of low",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        reasoning_effort: low\n",
     "replace": ""
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The tools do not send the customer the receipt themselves; the references are only in the tool result",
   "edits": [
    {
     "file": "lib/retention.py",
     "find": "\nTOOL_SENDS_RECEIPT = True\n",
     "replace": "\nTOOL_SENDS_RECEIPT = False\n"
    }
   ]
  },
  "no-words-guard": {
   "description": "hooks.py's output guard off: model text reaches the customer unchecked",
   "edits": [
    {
     "file": "hooks.py",
     "find": "\nENABLED = True\n",
     "replace": "\nENABLED = False\n"
    }
   ]
  }
 },
 "bot_text_metrics": {
  "offer_prompt": {
   "pattern": "\\b(?:i|we)(?:\\s+(?:can|could|am\\s+able\\s+to|are\\s+able\\s+to|would\\s+like\\s+to|want\\s+to)|['’]d\\s+like\\s+to|['’]d\\s+love\\s+to)\\s+(?:also\\s+|still\\s+)?(?:offer|give\\s+you|knock|reduce|drop|lower|take\\s+\\S+\\s+off|do\\s+you|match|apply\\s+(?:a|an)\\s+(?:discount|offer))|\\b(?:how\\s+about|what\\s+about|would\\s+you\\s+(?:like\\s+to\\s+hear|consider|be\\s+interested)|before\\s+you\\s+(?:go|cancel|leave)|instead\\s+of\\s+cancel+ing|reconsider|stay\\s+with\\s+us|there\\s+is\\s+(?:also\\s+)?(?:an|another)\\s+offer)\\b|\\b(?:special|exclusive|loyalty|retention|win-?back|better|another|different)\\s+(?:offer|deal|discount|price|rate)\\b|\\b\\d{1,3}\\s?%\\s+(?:off|discount)\\b|£\\s?\\d+(?:\\.\\d\\d)?\\s+(?:a|per)\\s+month\\s+for\\b",
   "unless_before": "\\b(?:not|no|never|nothing|without|won['’]t|can['’]t|cannot|don['’]t|isn['’]t|any\\s+more|anymore|stop(?:ped)?|unless|if\\s+you\\s+(?:ever|later|change))\\b|n['’]t\\b"
  },
  "closure_claim": {
   "pattern": "\\b(?:your|the)\\s+(?:mobile|fibre|broadband|plan|account|contract|line|service|sim|number|tablet(?:\\s+data)?\\s+sim|data\\s+sim)(?:\\s+(?:ending\\s+\\d+|plan|service|line|account|contract))?\\s+(?:has\\s+been|have\\s+been|is\\s+now|is|was|got)\\s+(?:now\\s+|already\\s+|officially\\s+|successfully\\s+)?(?:cancel+ed|closed|terminated|disconnected|ended|switched\\s+off)\\b|\\b(?:i|we)['’]?(?:ve|\\s+have)?\\s+(?:just\\s+|now\\s+|already\\s+)?(?:cancel+ed|closed|terminated|disconnected)\\s+(?:your|the)\\s+(?:mobile|fibre|broadband|plan|account|contract|line|service|sim|number|tablet)\\b",
   "unless_before": "\\b(?:not|no|never|nothing|until|unless|once|after|when|if|whether|cannot|won['’]t|isn['’]t|hasn['’]t|can['’]t|don['’]t|will|would|may|might|could|should)\\b|n['’]t\\b"
  },
  "cancellation_reference": "\\bJM-CXL-[0-9A-F]{6}\\b",
  "offer_reference": "\\bJM-RET-[0-9A-F]{6}\\b"
 },
 "tool_result_metrics": {
  "offers_recorded": {
   "tool": "accept_retention_offer",
   "field": "effects"
  }
 },
