{
 "schema": 1,
 "build": "travel-mass-rebooking-gpt-text",
 "case": "travel-mass-rebooking",
 "organisation": "Horizon Travel (fictional)",
 "model": "openai/gpt-5.5-2026-04-23",
 "price_model": "gpt-5.5-2026-04-23",
 "driver": "rest",
 "engine_errors": [],
 "settle_seconds": 3,
 "prior_cost_per_turn_usd": 0.06,
 "variants": {
  "reasoning-default": {
   "description": "Rasa's default reasoning effort for this model (none), instead of low",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        reasoning_effort: low\n",
     "replace": ""
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The tools do not send the passenger the receipt themselves; the outcome is only in the tool result",
   "edits": [
    {
     "file": "lib/rebooking.py",
     "find": "\nTOOL_SENDS_RECEIPT = True\n",
     "replace": "\nTOOL_SENDS_RECEIPT = False\n"
    }
   ]
  }
 },
 "bot_text_metrics": {
  "confirmed_claim": {
   "pattern": "\\b(?:(?:you(?:'re|\\s+are)|you've\\s+been|you\\s+have\\s+been)\\s+(?:now\\s+|all\\s+)?(?:rebooked|booked|confirmed)|(?:rebooking|booking|seat|flight|change|replacement)\\s+(?:is|has\\s+been|was)\\s+(?:now\\s+)?(?:confirmed|committed|ticketed|done|complete)|(?:i(?:'ve|\\s+have)|we(?:'ve|\\s+have))\\s+(?:now\\s+|successfully\\s+)?(?:rebooked|booked|confirmed)\\s+you)",
   "unless_before": "\\b(?:not|no|never|cannot|can't|won't|isn't|hasn't|haven't|wasn't|don't|until|unless|if|whether|once|when|before|after|yet|pending|only)\\b|n't\\b"
  }
 },
 "tool_result_metrics": {
  "commits_with_effect": {
   "tool": "commit_rebooking",
   "field": "effects"
  }
 },
 "log_events": [
  "mantle.turn.failed",
  "mantle.orchestrator.empty_llm_response",
  "mantle.memory.discovery.extractor.discover_facts.llm_error",
  "mantle.tool_confirmation.declined",
  "mantle.tool_confirmation.confirmed",
  "mantle.tool_confirmation.recall_after_resolve_rejected",
  "mantle.tool_confirmation.recall_rejected",
  "mantle.skill_executor.dispatch.gated_tool.blocked"
 ],
 "summary_note": "Synthetic scenario: Horizon Travel, the storm, its flights, passengers, cases and holds are fictional. Pass conditions read tool calls, arguments and guard outcomes from the tracker only. confirmed_claim counts bot sentences that call a rebooking confirmed, from bot text, and never decides pass or fail; case-build/case_metric.py joins them to the tool results for the case metric (confirmations without committed capacity over accepted recovery offers), counts rejected holds apart from abandoned ones, and measures receipt delivery. engine_errors is empty: no in-turn rejection the engine causes on every run is known for GPT-5.5, so any failed in-turn call is a provider error. Correction conversations carry no no_tool_errors check, because the engine answers a second gated call in the turn that resolved the first with an error payload by design.",
