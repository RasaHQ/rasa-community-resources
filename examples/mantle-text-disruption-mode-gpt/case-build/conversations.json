  "reasoning-default": {
   "description": "No reasoning_effort on the orchestrator model, so Rasa applies its default for GPT-5.5 (none)",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        api_key: ${OPENAI_API_KEY}\n        reasoning_effort: low\n",
     "replace": "        api_key: ${OPENAI_API_KEY}\n"
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The tools do not send the passenger the outcome themselves; the hold id and queue reference are only in the tool result",
