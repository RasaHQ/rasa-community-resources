{
 "schema": 1,
 "build": "banking-statement-search-gpt-text",
 "case": "banking-statement-search",
 "organisation": "Northgate Bank (fictional)",
 "model": "openai/gpt-5.5-2026-04-23",
 "price_model": "gpt-5.5-2026-04-23",
 "driver": "rest",
 "engine_errors": [],
 "settle_seconds": 3,
 "prior_cost_per_turn_usd": 0.05,
 "variants": {
  "reasoning-default": {
   "description": "No reasoning_effort on the orchestrator model, so Rasa applies its default for GPT-5.5 (none)",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        api_key: ${OPENAI_API_KEY}\n        reasoning_effort: low\n",
     "replace": "        api_key: ${OPENAI_API_KEY}\n"
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The search tools do not send the customer the receipt themselves; it is only in the tool result",
   "edits": [
    {
     "file": "lib/history.py",
     "find": "\nTOOL_SENDS_RECEIPT = True\n",
     "replace": "\nTOOL_SENDS_RECEIPT = False\n"
    }
   ]
  }
 },
 "bot_text_metrics": {
  "complete_claim": {
   "pattern": "\\b(?:in total|a total of|(?:your|the)\\s+(?:\\w+\\s+){0,2}total\\s+(?:is|was|comes? to|came to|of)|total(?:s|led|ling|ing)?\\s+(?:of\\s+)?\\$|altogether|in all\\b|all told|that'?s (?:all|everything|the (?:full|complete|whole))|(?:the|a|your) (?:full|complete|whole|entire) (?:list|total|picture|set|history)|(?:those|these) are all\\b|here are all\\b|all (?:of )?(?:your|the) (?:\\w+ ){0,3}transactions|you (?:spent|paid) \\$[\\d,]+(?:\\.\\d\\d)?)",
   "unless_before": "\\b(?:so far|shown|partial|partially|incomplete|not|isn't|aren't|wasn't|no|first|only|until|once|when|after|if|at least|yet|more|remaining|page|pages|continue|continuing|can't|cannot|unable|without)\\b|n't\\b"
  },
  "statement_claim": {
   "pattern": "\\b(?:statement (?:balance|total|amount)|closing balance|statement shows)",
   "unless_before": "\\b(?:not|isn't|no|never|differ|different|separate|rather than|instead|unlike)\\b|n't\\b"
  }
 },
 "tool_result_metrics": {
  "search_results_issued": {
   "tool": "search_transactions",
   "field": "effects"
  },
  "continuations_issued": {
   "tool": "continue_search",
   "field": "effects"
  }
 },
 "log_events": [
  "northgate.search_scope_guard",
  "mantle.orchestrator.empty_llm_response",
  "mantle.turn.failed",
  "mantle.memory.discovery.extractor.discover_facts.llm_error"
 ],
 "summary_note": "Synthetic scenario: Northgate Bank and all its data are fictional. Pass conditions read tool calls and search results from the tracker. complete_claim counts bot sentences that present a result set as complete and statement_claim counts sentences that mention a statement balance, whatever the searches said; case-build/case_metric.py joins them to search states for the case metric. Neither decides pass or fail.",
