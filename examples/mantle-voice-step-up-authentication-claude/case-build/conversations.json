  "variants": {
    "say-before-complete": {
      "description": "Skill steps 6 and 7 tell Claude to speak the outcome and reference as reply text in the same response as any complete_skill call, after the main run found the identity-desk reference unsaid before the hangup in 4 of 5 routes",
      "edits": [
        {
          "file": "skills/access_reset/skill.md",
          "find": "   and give the desk reference. Do not offer another way to verify.\n",
          "replace": "   and give the desk reference. Do not offer another way to verify.\n   Say this as reply text in the same response as any complete_skill\n   call; never call complete_skill with no text after a result the\n   caller has not heard.\n"
        },
        {
          "file": "skills/access_reset/skill.md",
          "find": "   authorization reference digit by digit, in the same reply. A second\n",
          "replace": "   authorization reference digit by digit, in the same reply, as reply\n   text beside any complete_skill call. A second\n"
        }
      ]
    },
    "prompt-cache": {
      "description": "LiteLLM's cache_control_injection_points on the model group (a breakpoint on the system message), as in the Claude text builds",
      "edits": [
        {
          "file": "integrations.yml",
          "find": "        api_key: ${ANTHROPIC_API_KEY}\n",
          "replace": "        api_key: ${ANTHROPIC_API_KEY}\n        cache_control_injection_points:\n          - location: message\n            role: system\n"
        }
      ]
    }
  },
  "bot_text_metrics": {
    "code_echo": {
      "pattern": "(?i)\\b(4\\W*1\\W*7\\W*2\\W*9\\W*3|four\\W+one\\W+seven\\W+two\\W+nine\\W+three)\\b"
    },
    "spoken_proof_request": {
      "pattern": "(?i)\\b(security questions?|employee (number|id)|date of birth|manager'?s name|one-time code|verification code|passcode|your password)\\b",
      "unless_before": "(?i)\\b(not|no|never|can't|cannot|won't|isn't|without|don't|doesn't|instead of)\\b|n't\\b"
    }
  },
