.env
.venv/
__pycache__/
*.pyc
.rasa/
models/
logs/
# The root .gitignore drops every results/ folder; recorded case-build runs are
# evidence and are committed. Server logs and raw usage stay local.
!case-build/results/
case-build/results/raw/
# Caller WAVs stay out of git except three samples; case-build/caller-audio/
# manifest.json lists every file's text and SHA-256, and
# case-build/render_caller_audio.py regenerates the rest.
case-build/caller-audio/*.wav
!case-build/caller-audio/carol-29126f792067.wav
!case-build/caller-audio/albion-6005a47b1447.wav
!case-build/caller-audio/albion-efec3d5914da.wav
