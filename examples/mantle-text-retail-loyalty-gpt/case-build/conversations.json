 "driver": "rest",
 "engine_errors": [],
 "settle_seconds": 3,
 "prior_cost_per_turn_usd": 0.04,
 "variants": {
  "reasoning-default": {
   "description": "Rasa's default reasoning_effort for the model (none) instead of low",
   "edits": [
    {
     "file": "integrations.yml",
     "find": "        reasoning_effort: low\n",
     "replace": ""
    }
   ]
  },
  "receipt-in-result-only": {
   "description": "The tools do not send the member the receipt themselves; the change and support references are only in the tool result",
   "edits": [
    {
     "file": "lib/subscriptions.py",
     "find": "\nTOOL_SENDS_RECEIPT = True\n",
     "replace": "\nTOOL_SENDS_RECEIPT = False\n"
    }
   ]
  },
  "no-words-guard": {
   "description": "hooks.py's output guard off: model text reaches the member unchecked",
   "edits": [
    {
     "file": "hooks.py",
     "find": "\nENABLED = True\n",
     "replace": "\nENABLED = False\n"
    }
   ]
  }
 },
 "bot_text_metrics": {
  "change_reference": "\\bWS-CHG-[0-9A-F]{6}\\b"
 },
 "tool_result_metrics": {
  "commands_sent": {
   "tool": "apply_subscription_change",
   "field": "effects"
  }
 },
