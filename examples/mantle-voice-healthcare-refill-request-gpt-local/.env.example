# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# OpenAI API key for the orchestrator model (integrations.yml). This is the
# only credential the running agent uses: speech runs on this machine.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only for re-rendering the case-build caller audio (Deepgram Aura-2,
# scripts/case_builds/render_caller_audio.py). The agent never reads it.
# DEEPGRAM_API_KEY=

# Only for downloading the gated NeuTTS-2E files (make neutts-models) after
# accepting their terms on huggingface.co. The agent never reads it.
# HF_TOKEN=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
