# ==============================================================================
# Copy to `.env` (make env) and fill in the values. Never commit `.env`.
# ==============================================================================

# Rasa Pro Developer Edition licence (one line, no quotes).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# OpenAI API key for the orchestrator model (integrations.yml). The case-build
# caller audio was also rendered with it (scripts/render_caller_audio.py).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deepgram API key: speech-to-text (Flux) and text-to-speech (Aura-2).
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional
# LOG_LEVEL=INFO
# RASA_TELEMETRY_ENABLED=false
