{
  "schema": 1,
  "build": "retail-return-claude-text",
  "case": "retail-return",
  "organisation": "Willow Shop (fictional)",
  "model": "anthropic/claude-sonnet-5-5",
  "price_model": "claude-sonnet-5-5",
  "model_price": {
    "model": "claude-sonnet-5-5",
    "litellm_provider": "anthropic",
    "input_cost_per_token": 2e-06,
    "output_cost_per_token": 1e-05,
    "cache_read_input_token_cost": 2e-07,
    "cache_creation_input_token_cost": 2.5e-06,
    "source": "https://platform.claude.com/docs/en/about-claude/pricing (Claude Sonnet 5.5: $2 / MTok base input, $2.50 / MTok 5m cache writes, $0.20 / MTok cache hits, $10 / MTok output)",
    "checked": "2026-09-29",
    "why": "LiteLLM 1.101.2's bundled price map has claude-sonnet-5 but no row for claude-sonnet-5-5, so without this every call's response_cost is null."
  },
  "driver": "rest",
  "engine_errors": [
    "does not support assistant message prefill"
  ],
  "settle_seconds": 3,
  "prior_cost_per_turn_usd": 0.05,
  "variants": {
    "no-turn-order-hook": {
      "description": "The project as it was for the as-shipped run: hooks.py disabled, so requests after a canned reply end on the assistant and Claude rejects them",
      "edits": [
        {
          "file": "hooks.py",
          "find": "\nENABLED = True\n",
          "replace": "\nENABLED = False\n"
        }
      ]
    },
    "no-greeting": {
      "description": "Session start binds the customer but sends no greeting, so the first main-loop request ends on the customer's message",
      "edits": [
        {
          "file": "skills/default_session_start/skill.md",
          "find": "  - id: greet\n    action: utter_greet\n",
          "replace": ""
        }
      ]
    },
    "denial-utterance": {
      "description": "The confirmation gate with utter_on_user_denial set, as the earlier builds had it, to check whether a correction at the question is still dropped with Claude",
      "edits": [
        {
          "file": "skills/start_return/skill.md",
          "find": "        utter_for_confirmation: utter_confirm_return_request\n",
          "replace": "        utter_for_confirmation: utter_confirm_return_request\n        utter_on_user_denial: utter_return_not_requested\n"
        },
        {
          "file": "skills/start_return/responses.yml",
          "find": "  utter_confirm_return_request:\n",
          "replace": "  utter_return_not_requested:\n    - text: Okay, I have not requested that return or exchange.\n  utter_confirm_return_request:\n"
        }
      ]
    },
    "prompt-cache": {
      "description": "LiteLLM's cache_control_injection_points on the model group, to check whether Claude prompt caching can be switched on from integrations.yml",
      "edits": [
        {
          "file": "integrations.yml",
          "find": "        api_key: ${ANTHROPIC_API_KEY}\n",
          "replace": "        api_key: ${ANTHROPIC_API_KEY}\n        cache_control_injection_points:\n          - location: message\n            role: system\n"
        }
      ]
    }
  },
  "bot_text_metrics": {
    "refund_claim": {
      "pattern": "\\b(?:refund(?:s)? (?:has|have|is|was|will be) (?:been )?(?:issued|processed|completed|approved|on (?:its|the) way|sent|done|confirmed)|(?:you(?:'ll| will)|you should) (?:get|receive|see) (?:a |your |the )?(?:full )?(?:refund|money back|\\$\\d)|(?:we(?:'ve| have)|i(?:'ve| have)) (?:refunded|issued (?:a |your |the )?refund)|(?:is|are|been|was|get|be) refunded|refund of \\$\\d[\\d.,]* (?:is|has|will))",
      "unless_before": "\\b(?:not|no|never|cannot|can't|won't|isn't|hasn't|haven't|don't|until|unless|if|whether|after|once|only|when|decid\\w*|inspect\\w*)\\b|n't\\b"
    }
  },
  "tool_result_metrics": {
    "labels_issued": {
      "tool": "submit_return_request",
      "field": "effects"
    }
  },
  "log_events": [
    "mantle.turn.failed",
    "mantle.orchestrator.empty_llm_response",
    "mantle.memory.discovery.extractor.discover_facts.llm_error",
    "mantle.tool_confirmation.declined",
    "mantle.tool_confirmation.confirmed",
    "mantle.tool_confirmation.recall_after_resolve_rejected",
    "mantle.tool_confirmation.recall_rejected",
    "willowshop.turn_order_fix"
  ],
  "summary_note": "Synthetic scenario: Willow Shop, its customers and orders are fictional. Pass conditions read tool calls, arguments and guard outcomes from the tracker only; the refund_claim count is read from bot text and reported separately from pass/fail. Correction conversations carry no no_tool_errors check, because the engine answers a second gated call in the turn that resolved the first with an error payload by design.",
