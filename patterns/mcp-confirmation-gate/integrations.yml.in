llm:
  model_group: orchestrator
model_groups:
  - id: orchestrator
    models:
      - provider: openai
        model: gpt-5.5-2026-04-23
        api_key: ${OPENAI_API_KEY}
        reasoning_effort: low
channels:
  rest:
    enabled: true
mcp_servers:
  - name: fictional_support
    url: http://127.0.0.1:MCP_PORT/mcp
    tool_timeout: 15
