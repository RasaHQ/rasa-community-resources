# ==============================================================================
# voice-handoff-context — pattern
# ==============================================================================
# Copy to `.env` and fill in the two required values. NEVER commit `.env`.
#
# The eval suite and the agent desk need NEITHER of these — they are pure and
# run offline:
#     make test
#     make desk
# Only training and talking to the agent need credentials.
# ==============================================================================

# Required — Rasa Pro. Free Developer Edition license (a long JWT, one line).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Required — LLM (routing + conversation). Used by integrations.yml.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
