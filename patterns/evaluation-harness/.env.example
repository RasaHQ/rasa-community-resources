# ==============================================================================
# evaluation-harness — pattern
# ==============================================================================
# Copy to `.env` and fill in the required values. NEVER commit `.env`.
# ==============================================================================

# Required — Rasa Pro. Free Developer Edition license (a long JWT, one line).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Required — LLM. Used by the agent under test (integrations.yml, model group
# `orchestrator`) AND by the simulation framework's two models in
# eval/conftest.yml: the user simulator and the judge. The
# `generative_response_is_relevant` assertion additionally embeds text with
# the same OpenAI credential.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
