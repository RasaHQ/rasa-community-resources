# ==============================================================================
# evaluation-harness — pattern
# ==============================================================================
# Copy to `.env` and fill in the required values. NEVER commit `.env`.
# ==============================================================================

# Required — Rasa Pro. Free Developer Edition license (a long JWT, one line).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Required — LLM. Used by integrations.yml for BOTH the agent under test
# (model group `orchestrator`) and the LLM judge (model group `judge`).
# The judge also needs embeddings for `generative_response_is_relevant`, which
# uses the same OpenAI credential.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required only for `rasa test du` — dialogue understanding tests sit behind a
# feature flag. Set to `true` before running them.
RASA_PRO_BETA_DIALOGUE_UNDERSTANDING_TEST=
