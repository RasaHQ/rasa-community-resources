# ==============================================================================
# voice-auth-stepup — pattern
# ==============================================================================
# Copy to `.env` and fill in the values. NEVER commit `.env`.
#
# Note what is NOT in this file: no passphrase, no OTP secret, no OTP provider
# credential. The pattern is fixture-backed and has no real factors to
# configure. If you wire in a real OTP provider, its key belongs here — and its
# codes belong in neither the logs nor the tracker. See the README.
# ==============================================================================

# Required — Rasa Pro. Free Developer Edition license (a long JWT, one line).
# https://rasa.com/rasa-pro-developer-edition-license-key-request/
RASA_LICENSE=

# Required — LLM (routing + conversation). Used by integrations.yml.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for the voice channel only. Text via `rasa inspect` needs no ASR/TTS.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=
