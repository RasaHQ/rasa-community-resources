{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data_ref",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "fetched_at",
    "as_of",
    "replay",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "The provider's own update time; null when the provider gives none. Never copied from fetched_at."
    },
    "replay": {
      "type": "boolean"
    },
    "delayed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "kind": {
            "const": "assumption"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
