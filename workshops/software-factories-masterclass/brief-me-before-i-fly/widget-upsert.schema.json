{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "widget.upsert",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "request_id", "widget_id", "component", "data_ref", "revision"],
  "properties": {
    "type": {"const": "widget.upsert"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "widget_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "component": {"enum": ["flight_status", "weather_hourly", "arrival_timeline", "market_watchlist"]},
    "data_ref": {"type": "string", "minLength": 1, "maxLength": 80},
    "revision": {"type": "integer", "minimum": 1}
  }
}
