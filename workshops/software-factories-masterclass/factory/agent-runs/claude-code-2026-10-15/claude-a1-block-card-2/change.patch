--- a/product/skills/block_card/skill.md
+++ b/product/skills/block_card/skill.md
@@ -0,0 +1,11 @@
+---
+id: block_card
+description: Lists the caller's cards and blocks a single card after the caller confirms.
+tool_constraints:
+  - block_card:
+      requires_confirmation:
+        enabled: true
+        utter_for_confirmation: confirm_block_card
+---
+Always call `list_cards` first so the caller can see which cards they have.
+Never block a card the caller has not confirmed. Block only the one card the caller names, passing its `card_id` to `block_card`. Blocking is irreversible.
--- a/product/skills/block_card/tools.py
+++ b/product/skills/block_card/tools.py
@@ -0,0 +1,27 @@
+from rasa.mantle.tools.decorator import tool
+from rasa.mantle.tools.result import ToolResult
+
+# Demo data; replace with the real card service when it is wired in.
+_CARDS = [
+    {"card_id": "card_1", "last4": "4242", "type": "debit", "status": "active"},
+    {"card_id": "card_2", "last4": "1881", "type": "credit", "status": "active"},
+]
+
+
+@tool(description="List the caller's cards. Call this first, before any block request.")
+async def list_cards() -> ToolResult:
+    return ToolResult(llm_response={"cards": _CARDS})
+
+
+@tool(
+    description=(
+        "Block exactly one card, identified by card_id, after the caller has "
+        "confirmed. Blocking is irreversible."
+    )
+)
+async def block_card(card_id: str) -> ToolResult:
+    for card in _CARDS:
+        if card["card_id"] == card_id:
+            card["status"] = "blocked"
+            return ToolResult(llm_response={"ok": True, "card_id": card_id})
+    return ToolResult(llm_response={"ok": False, "reason": "unknown card_id"})
--- a/product/tests/test_block_card.py
+++ b/product/tests/test_block_card.py
@@ -0,0 +1,51 @@
+import asyncio
+import importlib.util
+from pathlib import Path
+
+import yaml
+
+PRODUCT = Path(__file__).resolve().parents[1]
+SKILL_DIR = PRODUCT / "skills" / "block_card"
+
+
+def _load_tools():
+    spec = importlib.util.spec_from_file_location("block_card_tools", SKILL_DIR / "tools.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _frontmatter():
+    text = (SKILL_DIR / "skill.md").read_text()
+    return yaml.safe_load(text.split("---")[1])
+
+
+def test_list_cards_returns_cards():
+    tools = _load_tools()
+    result = asyncio.run(tools.list_cards())
+    assert result.llm_response["cards"]
+
+
+def test_block_card_blocks_only_the_named_card():
+    tools = _load_tools()
+    result = asyncio.run(tools.block_card(card_id="card_1"))
+    assert result.llm_response["ok"] is True
+    status = {c["card_id"]: c["status"] for c in tools._CARDS}
+    assert status["card_1"] == "blocked"
+    assert status["card_2"] == "active"
+
+
+def test_block_card_unknown_id_blocks_nothing():
+    tools = _load_tools()
+    result = asyncio.run(tools.block_card(card_id="nope"))
+    assert result.llm_response["ok"] is False
+    assert all(c["status"] == "active" for c in tools._CARDS)
+
+
+def test_only_block_card_requires_confirmation():
+    constraints = {k: v for entry in _frontmatter()["tool_constraints"] for k, v in entry.items()}
+    assert list(constraints) == ["block_card"]
+    gate = constraints["block_card"]["requires_confirmation"]
+    assert gate["enabled"] is True
+    responses = yaml.safe_load((PRODUCT / "responses.yml").read_text())["responses"]
+    assert gate["utter_for_confirmation"] in responses
