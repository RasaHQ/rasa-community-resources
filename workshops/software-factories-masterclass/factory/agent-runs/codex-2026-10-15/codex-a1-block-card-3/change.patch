--- a/product/skills/block_card/skill.md
+++ b/product/skills/block_card/skill.md
@@ -0,0 +1,27 @@
+---
+name: Block Card
+description: Help the caller list their cards and permanently block one selected card.
+tool_constraints:
+  - block_card:
+      requires_confirmation:
+        enabled: true
+        utter_for_confirmation: utter_confirm_block_card
+---
+
+Call `list_cards` first to retrieve the caller's cards. Use only the returned
+card IDs; never invent a card or select one on the caller's behalf. Present
+the card names and last four digits. If the caller's choice is ambiguous, ask
+which card they mean before proceeding. If there are no cards, explain that
+there is no card available to block.
+
+Identify the selected card clearly to the caller and explain that blocking is
+permanent and cannot be undone by the caller. Request `block_card` with exactly
+that card's `card_id`; the engine will pause and ask for confirmation using the
+configured response before executing the tool. Never block a card the caller
+has not explicitly confirmed. A request to block, silence, or an ambiguous reply
+is not confirmation. If the caller declines, cancel the pending operation. If
+they change cards, cancel the pending operation and obtain fresh confirmation
+for the new card. Never reuse confirmation for a different card.
+
+Report success only when the tool reports success. Explain any returned error
+without claiming that the card was blocked. Do not offer to unblock a card.
--- a/product/skills/block_card/tools.py
+++ b/product/skills/block_card/tools.py
@@ -0,0 +1,25 @@
+"""Caller-scoped demo card operations; no bank integration is configured."""
+
+from copy import deepcopy
+
+from rasa.mantle.tools.decorator import ToolContext, tool
+from rasa.mantle.tools.result import ToolResult
+
+
+@tool(description="List the caller's cards before selecting a card to block.")
+async def list_cards(context: ToolContext) -> ToolResult:
+    return ToolResult(llm_response={"cards": deepcopy(context.memory.get("cards", []))})
+
+
+@tool(description="Permanently block exactly the selected card after caller confirmation.")
+async def block_card(card_id: str, context: ToolContext) -> ToolResult:
+    """The skill's engine confirmation gate must resolve before this runs."""
+    cards = deepcopy(context.memory.get("cards", []))
+    matches = [card for card in cards if card["card_id"] == card_id]
+    if len(matches) != 1:
+        return ToolResult(llm_response={"ok": False, "error": "unknown_or_ambiguous_card"})
+    if context.is_cancelled:
+        return ToolResult(llm_response={"ok": False, "error": "interrupted"})
+    matches[0]["status"] = "blocked"
+    context.memory.set("cards", cards)
+    return ToolResult(llm_response={"ok": True, "card_id": card_id, "status": "blocked"})
--- a/product/tests/test_block_card.py
+++ b/product/tests/test_block_card.py
@@ -0,0 +1,60 @@
+"""Behavior checks for the caller-scoped demo card tools."""
+
+import importlib.util
+import unittest
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import yaml
+
+
+SKILL = Path(__file__).resolve().parents[1] / "skills" / "block_card"
+SPEC = importlib.util.spec_from_file_location("block_card_tools", SKILL / "tools.py")
+TOOLS = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(TOOLS)
+
+
+def caller():
+    schema = yaml.safe_load((SKILL / "memory.yml").read_text())
+    state = {"cards": deepcopy(schema["schema"]["private"]["cards"]["initial_value"])}
+    memory = SimpleNamespace(get=state.get, set=Mock(side_effect=state.__setitem__))
+    return SimpleNamespace(memory=memory, is_cancelled=False)
+
+
+class CardToolsTests(unittest.IsolatedAsyncioTestCase):
+    async def test_only_selected_card_changes_and_retries_are_idempotent(self):
+        context = caller()
+        before = (await TOOLS.list_cards(context)).llm_response["cards"]
+        selected = before[1]["card_id"]
+        result = await TOOLS.block_card(selected, context)
+        self.assertTrue(result.llm_response["ok"])
+        after = (await TOOLS.list_cards(context)).llm_response["cards"]
+        self.assertEqual(after[0], before[0])
+        self.assertEqual(after[1], {**before[1], "status": "blocked"})
+        await TOOLS.block_card(selected, context)
+        self.assertEqual((await TOOLS.list_cards(context)).llm_response["cards"], after)
+        self.assertEqual((await TOOLS.list_cards(caller())).llm_response["cards"], before)
+
+    async def test_unknown_card_and_interruption_do_not_write(self):
+        context = caller()
+        result = await TOOLS.block_card("not_the_callers_card", context)
+        self.assertFalse(result.llm_response["ok"])
+        context.is_cancelled = True
+        result = await TOOLS.block_card(context.memory.get("cards")[0]["card_id"], context)
+        self.assertFalse(result.llm_response["ok"])
+        context.memory.set.assert_not_called()
+
+    async def test_listing_is_read_only_and_returns_a_copy(self):
+        context = caller()
+        result = await TOOLS.list_cards(context)
+        result.llm_response["cards"][0]["status"] = "blocked"
+        self.assertEqual(context.memory.get("cards")[0]["status"], "active")
+        context.memory.set.assert_not_called()
+
+    async def test_no_cards(self):
+        context = caller()
+        context.memory.set("cards", [])
+        self.assertEqual((await TOOLS.list_cards(context)).llm_response["cards"], [])
+        self.assertFalse((await TOOLS.block_card("card_debit", context)).llm_response["ok"])
