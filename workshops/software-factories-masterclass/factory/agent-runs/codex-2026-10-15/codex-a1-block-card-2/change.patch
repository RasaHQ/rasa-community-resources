--- a/product/skills/block_card/skill.md
+++ b/product/skills/block_card/skill.md
@@ -0,0 +1,25 @@
+---
+name: block_card
+description: List the caller's cards and permanently block one selected card.
+tool_constraints:
+  - block_card:
+      requires_confirmation:
+        enabled: true
+        utter_for_confirmation: utter_confirm_block_card
+---
+
+Call `list_cards` first, even if the caller has already supplied a card ID.
+Use only cards returned by that tool. If no cards are available, explain that
+there is no card available to block and stop.
+
+Help the caller identify exactly one card by its card ID and available masked
+details. If their choice is ambiguous, ask which card they mean. Never guess a
+card ID. Tell the caller which card is selected and that blocking is permanent
+and cannot be undone by them.
+
+Invoke `block_card` with only the selected `card_id`; the engine must pause for
+the confirmation response before executing it. Never block a card the caller
+has not confirmed. If the caller declines, cancel. If they change their choice,
+cancel the pending operation and obtain fresh confirmation for the new card.
+Do not treat confirmation for one card as permission to block another or all
+cards. Report success only when the tool returns a successful result.
--- a/product/skills/block_card/tools.py
+++ b/product/skills/block_card/tools.py
@@ -0,0 +1,29 @@
+"""Card operations on caller-scoped records; no shared global card state."""
+
+from copy import deepcopy
+
+from rasa.mantle.tools.decorator import ToolContext, tool
+from rasa.mantle.tools.result import ToolResult
+
+
+@tool(description="Return the caller's cards, including their IDs and status.")
+async def list_cards(context: ToolContext) -> ToolResult:
+    return ToolResult(llm_response={"cards": deepcopy(context.memory.get("cards", []))})
+
+
+@tool(description="Permanently block exactly one caller-owned card after confirmation.")
+async def block_card(card_id: str, context: ToolContext) -> ToolResult:
+    cards = deepcopy(context.memory.get("cards", []))
+    matches = [card for card in cards if card.get("card_id") == card_id]
+    if not card_id or len(matches) != 1:
+        return ToolResult(llm_response={"ok": False, "error": "card_not_found_or_ambiguous"})
+
+    card = matches[0]
+    if card.get("status") == "blocked":
+        return ToolResult(llm_response={"ok": True, "card_id": card_id, "status": "blocked"})
+    if context.is_cancelled:
+        return ToolResult(llm_response={"ok": False, "error": "interrupted"})
+
+    card["status"] = "blocked"
+    context.memory.set("cards", cards)
+    return ToolResult(llm_response={"ok": True, "card_id": card_id, "status": "blocked"})
--- a/product/tests/test_block_card.py
+++ b/product/tests/test_block_card.py
@@ -0,0 +1,70 @@
+from copy import deepcopy
+from types import SimpleNamespace
+import unittest
+
+from product.skills.block_card.tools import block_card, list_cards
+
+
+class Memory:
+    def __init__(self, cards):
+        self.data = {"cards": deepcopy(cards)}
+        self.writes = 0
+
+    def get(self, name, default=None):
+        return self.data.get(name, default)
+
+    def set(self, name, value):
+        self.data[name] = value
+        self.writes += 1
+
+
+def caller(cards):
+    return SimpleNamespace(memory=Memory(cards), is_cancelled=False)
+
+
+class CardToolsTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.cards = [
+            {"card_id": "one", "status": "active", "last_four": "1234"},
+            {"card_id": "two", "status": "active", "last_four": "5678"},
+        ]
+        self.context = caller(self.cards)
+
+    async def test_list_is_read_only_and_returns_caller_cards(self):
+        result = await list_cards(self.context)
+        self.assertEqual(result.llm_response["cards"], self.cards)
+        result.llm_response["cards"][0]["status"] = "blocked"
+        self.assertEqual(self.context.memory.data["cards"], self.cards)
+        self.assertEqual(self.context.memory.writes, 0)
+        self.assertEqual((await list_cards(caller([]))).llm_response["cards"], [])
+
+    async def test_blocks_only_selected_card_and_is_idempotent(self):
+        other_caller = caller(self.cards)
+        result = await block_card("two", self.context)
+        self.assertTrue(result.llm_response["ok"])
+        expected = deepcopy(self.cards)
+        expected[1]["status"] = "blocked"
+        self.assertEqual((await list_cards(self.context)).llm_response["cards"], expected)
+        await block_card("two", self.context)
+        self.assertEqual(self.context.memory.writes, 1)
+        self.assertEqual(other_caller.memory.data["cards"], self.cards)
+
+    async def test_unknown_or_ambiguous_id_changes_nothing(self):
+        for card_id in ("missing", "", "one,two"):
+            result = await block_card(card_id, self.context)
+            self.assertFalse(result.llm_response["ok"])
+        self.assertEqual(self.context.memory.data["cards"], self.cards)
+        self.assertEqual(self.context.memory.writes, 0)
+        duplicate = caller([self.cards[0], self.cards[0]])
+        self.assertFalse((await block_card("one", duplicate)).llm_response["ok"])
+        self.assertEqual(duplicate.memory.writes, 0)
+
+    async def test_interruption_leaves_cards_unchanged(self):
+        self.context.is_cancelled = True
+        self.assertFalse((await block_card("one", self.context)).llm_response["ok"])
+        self.assertEqual(self.context.memory.data["cards"], self.cards)
+        self.assertEqual(self.context.memory.writes, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
